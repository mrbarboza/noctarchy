#!/usr/bin/env bash
set -euo pipefail

THEME="${1:-}"

if [[ -z "$THEME" ]]; then
  echo "Usage: theme-select <theme-name>"
  REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  if [[ -d "$REPO_ROOT/themes" ]]; then
    echo "Available themes:"
    ls -1 "$REPO_ROOT/themes"
  fi
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
THEME_DIR="$REPO_ROOT/themes/$THEME"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
NOCTALIA_THEME="$CONFIG_HOME/noctalia/theme.toml"
COLORS_TOML="$THEME_DIR/colors.toml"

if [[ ! -d "$THEME_DIR" ]]; then
  echo "Theme '$THEME' not found in $THEME_DIR"
  exit 1
fi

if [[ ! -f "$COLORS_TOML" ]]; then
  echo "Warning: No colors.toml for $THEME"
  exit 1
fi

mkdir -p "$(dirname "$NOCTALIA_THEME")"
cat > "$NOCTALIA_THEME" <<EOF
# Selected theme
name = "$THEME"
EOF

echo "Theme: $THEME"
echo "Niri colors are applied via Noctalia's own builtin niri template (see docs/THEMES.md)."
