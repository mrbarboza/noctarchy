// ~/.config/niri/config.kdl
// Noctarchy — Niri config (zero DHH/HEY references)

// === Autostart Noctalia ===
spawn-at-startup "noctalia"

// === Output/Monitor ===
output "eDP-1" {
    scale 1.5
}

// === Tecla Mod ===
mod "Super"

// === Apps ===
bind "Mod+Return" { spawn "kitty"; }
bind "Mod+Shift+E" { spawn "firefox"; }
bind "Mod+Shift+C" { spawn "kitty -e btop"; }
bind "Mod+Shift+F" { spawn "firefox"; }
bind "Mod+Shift+T" { spawn "kitty -e tmux"; }
bind "Mod+Shift+G" { spawn "lazygit"; }
bind "Mod+Shift+N" { spawn "kitty -e nvim"; }
bind "Mod+Shift+Q" { close-window; }

// === Navegacao scrollable-tiling ===
bind "Mod+H" { focus-column-left; }
bind "Mod+L" { focus-column-right; }
bind "Mod+J" { focus-window-down; }
bind "Mod+K" { focus-window-up; }
bind "Mod+Shift+H" { move-column-left; }
bind "Mod+Shift+L" { move-column-right; }
bind "Mod+Shift+J" { move-window-down; }
bind "Mod+Shift+K" { move-window-up; }

// === Resize ===
bind "Mod+Ctrl+H" { set-column-width "-10%"; }
bind "Mod+Ctrl+L" { set-column-width "+10%"; }

// === Workspaces ===
bind "Mod+1" { focus-workspace 1; }
bind "Mod+2" { focus-workspace 2; }
bind "Mod+3" { focus-workspace 3; }
bind "Mod+4" { focus-workspace 4; }
bind "Mod+5" { focus-workspace 5; }
bind "Mod+6" { focus-workspace 6; }
bind "Mod+7" { focus-workspace 7; }
bind "Mod+8" { focus-workspace 8; }
bind "Mod+9" { focus-workspace 9; }

bind "Mod+Shift+1" { move-to-workspace 1; }
bind "Mod+Shift+2" { move-to-workspace 2; }
bind "Mod+Shift+3" { move-to-workspace 3; }
bind "Mod+Shift+4" { move-to-workspace 4; }
bind "Mod+Shift+5" { move-to-workspace 5; }
bind "Mod+Shift+6" { move-to-workspace 6; }
bind "Mod+Shift+7" { move-to-workspace 7; }
bind "Mod+Shift+8" { move-to-workspace 8; }
bind "Mod+Shift+9" { move-to-workspace 9; }

// === Overview + Launcher ===
bind "Mod+Space" { toggle-overview; }

// === Screenshot ===
bind "Mod+Shift+S" { screenshot; }
bind "Mod+Shift+P" { screenshot-window; }
bind "Mod+Shift+A" { screenshot-screen; }

// === Fullscreen / Float ===
bind "Mod+F" { set-fullscreen true; }
bind "Mod+Shift+F" { toggle-float; }

// === Blur ===
blur {
    enabled true
    radius 20
    passes 3
}

// === Animacoes ===
animation {
    spring {
        mass 1.0
        stiffness 200.0
        damping 20.0
    }
}

// === Layer rules Noctalia ===
layer-rule namespace="noctalia-bar" {
    ignore-exclude-from-window-switcher true
}

layer-rule namespace="noctalia-launcher" {
    ignore-exclude-from-window-switcher true
}

layer-rule namespace="noctalia-notifications" {
    ignore-exclude-from-window-switcher true
}
