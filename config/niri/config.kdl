// Noctarchy Niri configuration
// Theme colors come from Noctalia's own builtin "niri" template, which
// Noctalia's apply.sh writes to ~/.config/niri/noctalia.kdl and manages the
// include for. Enable it in ~/.config/noctalia/templates.toml — see
// docs/THEMES.md for the exact keys.

// Add your existing Niri config below this line

// Keybindings, ported from Omarchy's Hyprland bindings where a niri-native
// equivalent exists (see docs/MIGRATION.md and the parity survey). "Mod" is
// Super on a real TTY session. Syntax verified against niri's own shipped
// resources/default-config.kdl (https://github.com/YaLTeR/niri) - no "bind"
// keyword, no quotes around the key combo, action goes inside braces.

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // Core app launchers
    Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+B hotkey-overlay-title="Open a Browser: firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="Open an Editor: nvim" { spawn "kitty" "-e" "nvim"; }
    Mod+Shift+E hotkey-overlay-title="Open a File Manager: nautilus" { spawn "nautilus"; }

    // Window / column focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Switch to workspace (numbered)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Fullscreen / maximize - single-key semantics: Mod+F maximizes the
    // column (keeps other columns reachable), Mod+Shift+F goes fullscreen.
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Overview
    Mod+Tab repeat=false { toggle-overview; }

    // Close window
    Mod+Q { close-window; }

    // Media / hardware keys - mirrors niri's own shipped default pattern
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Screenshots - native niri actions, no scripts needed
    Print       { screenshot-screen; }
    Ctrl+Print  { screenshot; }
    Alt+Print   { screenshot-window; }

    // Noctalia shell IPC - bar/panel/notification control
    Mod+Shift+B { spawn-sh "noctalia msg bar-toggle"; }
    Mod+N       { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Space   { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+D       { spawn-sh "noctalia msg notification-dnd-toggle"; }
    Mod+Shift+N { spawn-sh "noctalia msg notification-clear-active"; }
    // Screenshot capture with clipboard copy and an editor-open notification
    // action, on top of the native binds above (bin/capture-screenshot).
    // "windows"/"smart" snap the slurp highlight to a window or monitor
    // rectangle on mouse hover; "pick" is a keyboard-only fuzzel dmenu list
    // of windows, since niri has no cursor-warp IPC to drive slurp by
    // keyboard the way Omarchy's Hyprland-only Tab-cycling trick does.
    Mod+Print             { spawn-sh "$HOME/.config/niri/bin/capture-screenshot region"; }
    Mod+Shift+Print       { spawn-sh "$HOME/.config/niri/bin/capture-screenshot fullscreen"; }
    Mod+Alt+Print         { spawn-sh "$HOME/.config/niri/bin/capture-screenshot windows"; }
    Mod+Ctrl+Print        { spawn-sh "$HOME/.config/niri/bin/capture-screenshot smart"; }
    Mod+Ctrl+Shift+Print  { spawn-sh "$HOME/.config/niri/bin/capture-screenshot pick"; }

    // Capture helpers - region select, then decode/OCR
    Mod+Shift+Q hotkey-overlay-title="Decode a QR code from a screen region" { spawn "capture-qr"; }
    Mod+Shift+T hotkey-overlay-title="Extract text from a screen region (OCR)" { spawn "capture-text"; }

    // Screen recording (start/stop toggle) - portal capture picker lets you
    // choose monitor/window/region
    Mod+Alt+Print { spawn-sh "$HOME/.config/niri/bin/capture-screenrecording --with-desktop-audio"; }
}
