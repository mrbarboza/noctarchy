# Catppuccin Mocha tmux theme
set -g status-style "bg=#1e1e2e,fg=#cdd6f4"
set -g status-left-style "bg=#89b4fa,fg=#1e1e2e"
set -g status-right-style "bg=#1e1e2e,fg=#cdd6f4"
set -g window-style "bg=#1e1e2e,fg=#cdd6f4"
set -g window-active-style "bg=#1e1e2e,fg=#89b4fa"
set -g pane-border-style "fg=#585b70"
set -g pane-active-border-style "fg=#89b4fa"
set -g message-style "bg=#45475a,fg=#cdd6f4"
