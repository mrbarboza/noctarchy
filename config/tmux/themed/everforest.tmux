# Everforest tmux theme
set -g status-style "bg=#2d353b,fg=#d3c6aa"
set -g status-left-style "bg=#a7c080,fg=#2d353b"
set -g status-right-style "bg=#2d353b,fg=#d3c6aa"
set -g window-style "bg=#2d353b,fg=#d3c6aa"
set -g window-active-style "bg=#2d353b,fg=#a7c080"
set -g pane-border-style "fg=#5c6870"
set -g pane-active-border-style "fg=#a7c080"
set -g message-style "bg=#485359,fg=#d3c6aa"
