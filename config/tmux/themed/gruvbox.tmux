# Gruvbox tmux theme
set -g status-style "bg=#282828,fg=#ebdbb2"
set -g status-left-style "bg=#fabd2f,fg=#282828"
set -g status-right-style "bg=#282828,fg=#ebdbb2"
set -g window-style "bg=#282828,fg=#ebdbb2"
set -g window-active-style "bg=#282828,fg=#fabd2f"
set -g pane-border-style "fg=#665c54"
set -g pane-active-border-style "fg=#fabd2f"
set -g message-style "bg=#504945,fg=#ebdbb2"
