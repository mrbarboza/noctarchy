# Kanagawa tmux theme
set -g status-style "bg=#16161d,fg=#dcd7ba"
set -g status-left-style "bg=#7aa89f,fg=#16161d"
set -g status-right-style "bg=#16161d,fg=#dcd7ba"
set -g window-style "bg=#16161d,fg=#dcd7ba"
set -g window-active-style "bg=#16161d,fg=#7aa89f"
set -g pane-border-style "fg=#444550"
set -g pane-active-border-style "fg=#7aa89f"
set -g message-style "bg=#2d2d36,fg=#dcd7ba"
