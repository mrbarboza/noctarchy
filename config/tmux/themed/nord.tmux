# Nord tmux theme
set -g status-style "bg=#2e3440,fg=#eceff4"
set -g status-left-style "bg=#88c0d0,fg=#2e3440"
set -g status-right-style "bg=#2e3440,fg=#eceff4"
set -g window-style "bg=#2e3440,fg=#eceff4"
set -g window-active-style "bg=#2e3440,fg=#88c0d0"
set -g pane-border-style "fg=#4c566a"
set -g pane-active-border-style "fg=#88c0d0"
set -g message-style "bg=#434c5e,fg=#eceff4"
