# Rose Pine tmux theme
set -g status-style "bg=#191724,fg=#e0def4"
set -g status-left-style "bg=#c4a7e7,fg=#191724"
set -g status-right-style "bg=#191724,fg=#e0def4"
set -g window-style "bg=#191724,fg=#e0def4"
set -g window-active-style "bg=#191724,fg=#c4a7e7"
set -g pane-border-style "fg=#44415a"
set -g pane-active-border-style "fg=#c4a7e7"
set -g message-style "bg=#38344d,fg=#e0def4"
